{
  "name": "tingyu-music",
  "productName": "弦栖霁",
  "version": "1.0.8",
  "private": true,
  "type": "module",
  "description": "弦栖霁 · 本地音乐与离线双语歌词播放器",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/sync-update-trust.cjs && node scripts/make-icon.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "desktop": "npm run build && electron .",
    "pack:win": "npm run build && node scripts/package-desktop.cjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "demo": "node scripts/make-demo.mjs",
    "release:create": "node scripts/create-update-release.cjs",
    "release:publish": "node scripts/publish-update.cjs",
    "publish:check": "node scripts/release-one-click.cjs --check",
    "publish:prepare": "node scripts/release-one-click.cjs --prepare --interactive",
    "publish:all": "node scripts/release-one-click.cjs --publish --interactive",
    "publish:resume": "node scripts/release-one-click.cjs --resume --interactive",
    "test:release": "node scripts/check-release-pipeline.cjs",
    "source:package": "node scripts/package-library-server.cjs",
    "android:sign-release": "node scripts/sign-android-release.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "@noble/hashes": "^2.4.0",
    "@zip.js/zip.js": "^2.23.0",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "music-metadata": "^12.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.0.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "com.tingyu.music",
    "productName": "弦栖霁",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "updates/public.json",
      "updates/protocol.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "artifactName": "Xianqiji-${version}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "installerLanguages": [
        "zh_CN"
      ],
      "include": "build/installer.nsh",
      "artifactName": "Xianqiji-Setup-${version}-${arch}.${ext}"
    }
  }
}
